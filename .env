# Base environment variables — committed to git, loaded in ALL modes.
# Values here are defaults; override per-mode in .env.development / .env.production,
# or override locally (untracked) in .env.local / .env.[mode].local.
#
# Only variables prefixed with VITE_ are exposed to client-side code via import.meta.env.

VITE_APP_NAME="PWA Boilerplate"
VITE_APP_DESCRIPTION="Single page progressive web application boilerplate using Vite + React + TypeScript + Tailwind CSS + Material UI."
VITE_API_BASE_URL="/api"
